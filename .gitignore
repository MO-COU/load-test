# Gradle 빌드 캐시와 결과물은 저장소에 올리지 않는다.
.gradle/
build/

# STS/Eclipse가 생성하는 프로젝트 설정과 컴파일 결과물이다.
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# IntelliJ IDEA와 VS Code의 개인 IDE 설정이다.
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/

# 운영체제와 Spring Initializr가 생성하는 로컬 파일이다.
.DS_Store
Thumbs.db
HELP.md

# 개인 MySQL 접속 정보는 저장소에 올리지 않는다.
/application-local.properties
/src/main/resources/application-local.properties
